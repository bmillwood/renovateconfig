{
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Renovate image used by the renovate script",
      "managerFilePatterns": ["/^renovate$/"],
      "matchStrings": ["renovate_image=(?<depName>[^:\\s]+):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
